# Existing Confluence knowledge-base service
CONFLUENCE_KB_URL=https://knowledge-base.example
CONFLUENCE_KB_API_KEY=replace-me
CONFLUENCE_KB_VERIFY_SSL=false

# OpenAI-compatible Qwen chat service
LLM_BASE_URL=http://10.245.65.19:11082
LLM_API_KEY=
LLM_MODEL=qwen3-8b
