# Existing Confluence knowledge-base service
CONFLUENCE_KB_URL=https://knowledge-base.example
CONFLUENCE_KB_API_KEY=replace-me
CONFLUENCE_KB_VERIFY_SSL=false

# Anthropic-compatible model gateway
ANTHROPIC_BASE_URL=http://model-gateway.example:4000
ANTHROPIC_AUTH_TOKEN=replace-me
ANTHROPIC_MODEL=replace-with-gateway-model-name
ANTHROPIC_VERIFY_SSL=true

# Service defaults
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_ALPHA=0.5
RAG_DEFAULT_MAX_CONTEXT_CHARS=20000
RAG_REQUEST_TIMEOUT_SECONDS=60
