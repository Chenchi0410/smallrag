# Service defaults
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_ALPHA=0.5
RAG_DEFAULT_MAX_CONTEXT_CHARS=20000
RAG_REQUEST_TIMEOUT_SECONDS=60

# HTTPS server
SERVER_HOST=0.0.0.0
SERVER_PORT=18082
HTTPS_CERTFILE=/certs/server.crt
HTTPS_KEYFILE=/certs/server.key
